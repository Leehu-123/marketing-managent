# --- SYSTEM CONFIGURATION ---
# Môi trường chạy app: development / production
ENV=development

# Cấu hình Database
# Mặc định sử dụng SQLite cục bộ. Để dùng PostgreSQL, đổi URL thành: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///./dafa_glass.db

# --- AI INTEGRATION (OPENAI) ---
# Đặt MOCK_AI=true để chạy giả lập không cần API key OpenAI
MOCK_AI=true
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# --- AI IMAGE GENERATION ---
# Đặt MOCK_IMAGE_GEN=false để gọi provider tạo ảnh thật
MOCK_IMAGE_GEN=true
# image_provider: replicate / Gemini (Image) / OpenAI (Image) / 9Router (Image)
IMAGE_PROVIDER=replicate
REPLICATE_API_TOKEN=your-replicate-api-token
REPLICATE_FLUX_MODEL=black-forest-labs/flux-schnell

# --- FACEBOOK FANPAGE INTEGRATION ---
# Đặt MOCK_META=true để chạy giả lập không cần API key Meta
MOCK_META=true
META_PAGE_ID=your-facebook-page-id
META_PAGE_ACCESS_TOKEN=your-page-access-token

# --- WEBSITE CMS INTEGRATION (WORDPRESS) ---
# Đặt MOCK_CMS=true để chạy giả lập không cần tài khoản WordPress
MOCK_CMS=true
WP_API_URL=https://your-wordpress-website.com/wp-json
WP_USERNAME=your-wp-admin-username
WP_APP_PASSWORD=your-wp-application-password

# --- ANALYTICS INTEGRATION (GOOGLE ANALYTICS 4) ---
# Đặt MOCK_ANALYTICS=true để chạy giả lập không cần API key Google
MOCK_ANALYTICS=true
GA4_PROPERTY_ID=your-ga4-property-id
GOOGLE_APPLICATION_CREDENTIALS_JSON=your-google-credentials-json-content
